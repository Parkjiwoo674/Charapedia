PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=charapedia_db

# 32자 이상의 랜덤 문자열로 바꾸세요 (생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# 프론트 주소 (여러 개면 쉼표로 구분: http://localhost:5173,https://내프론트.vercel.app)
CLIENT_URL=http://localhost:5173

# 배포(Render/Railway 등)에서는 production 으로. 서버가 약한 JWT_SECRET이면 시작을 거부함
NODE_ENV=development
# 프록시 뒤에서 돌릴 때(Render/Railway)는 1. 로컬에서는 비워두기 (IP 기준 요청 제한이 정확히 동작하게 함)
TRUST_PROXY=

GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
# 개발/테스트용: 1이면 실제 메일을 보내지 않고 인증번호를 서버 콘솔에 출력 (운영에서는 사용 불가)
# MAIL_DRY_RUN=1

# ---- 배포(Railway)용 메일 설정 ----
# Railway 무료/Hobby 플랜은 Gmail SMTP가 막혀 있어서 Brevo(HTTPS API)로 보낸다.
# BREVO_API_KEY가 있으면 Brevo로, 없으면 위의 Gmail로 보낸다.
# BREVO_API_KEY=xkeysib-...
# Brevo에서 "인증(Verify)한" 보내는 사람 이메일 주소
# MAIL_FROM=your_verified_sender@gmail.com

# TiDB Cloud 처럼 암호화(TLS) 접속이 필요한 외부 DB를 쓸 때만 true (로컬 MySQL은 비워두기)
# DB_SSL=true
